# Original Multi-Stage Dockerfile
# Stage 1: Build
FROM golang:1.21.13-bookworm AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /hello-server

# Stage 2: Runtime
FROM debian:bookworm-slim

WORKDIR /app
COPY --from=builder /hello-server /app/hello-server

EXPOSE 8080

CMD ["/app/hello-server"]