# Original Single-Stage Dockerfile
FROM golang:1.21.13-bookworm

WORKDIR /app

# Copy Go module files first for caching
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the binary
RUN CGO_ENABLED=0 GOOS=linux go build -o /hello-server

EXPOSE 8080

CMD ["/hello-server"]